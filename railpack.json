{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "steps": {
    "install": {
      "inputs": ["."],
      "commands": ["pip install -r requirements.txt"]
    }
  },
  "deploy": {
    "inputs": ["install", "."],
    "startCommand": "python -m uvicorn server.main:app --host 0.0.0.0 --port $PORT"
  }
}
