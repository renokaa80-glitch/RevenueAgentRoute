{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "steps": {
    "install": {
      "inputs": [{"local": true}],
      "commands": ["pip install -r requirements.txt"]
    }
  },
  "deploy": {
    "inputs": [{"step": "install"}, {"local": true}],
    "startCommand": "python -m uvicorn server.main:app --host 0.0.0.0 --port $PORT"
  }
}
